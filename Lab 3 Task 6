#include <iostream>
using namespace std;

class Node {
public:
    int value;
    Node* next;
};

class List {
private:
    Node* head;

public:
    List() {
        head = NULL;
    }

    void insertAtHead(int new_value) {
        Node* temp = new Node();
        temp->value = new_value;
        temp->next = head;
        head = temp;
    }

    void insertAtLocation(int location, int new_value) {
        Node* temp = head;

        for (int i = 1; i < location - 1; i++) {
            temp = temp->next;
        }

        Node* newNode = new Node();
        newNode->value = new_value;
        newNode->next = temp->next;
        temp->next = newNode;
    }

    void displayList() {
        Node* temp = head;
        while (temp != NULL) {
            cout << temp->value << " ";
            temp = temp->next;
        }
        cout << endl;
    }

    void deleteNode(int position) {
        Node* temp = head;

        if (position == 1) {
            head = temp->next;
            cout << "The node deleted by the user is at position " << position << ". Which had the data " << temp->value << endl;
            delete temp;
            return;
        }

        for (int i = 1; i < position - 1; i++) {
            temp = temp->next;
        }

        Node* tempPtr = temp->next;
        temp->next = temp->next->next;
        cout << "The node deleted by the user is at position " << position << ". Which had the data " << tempPtr->value << endl;
        delete tempPtr;
    }

    int countList() {
        Node* temp = head;
        int count = 0;
        while (temp != NULL) {
            count++;
            temp = temp->next;
        }
        return count;
    }
};

int main() {
    List myList;

    // sample linked list created using insertAtHead
    myList.insertAtHead(10);
    myList.insertAtHead(20);
    myList.insertAtHead(30);

    cout << "Sample linked list before using menu: ";
    myList.displayList();

    int choice;
    int new_value, location, position;

    do {
        cout << endl << "----- MENU -----" << endl;
        cout << "1. Insert node at head" << endl;
        cout << "2. Insert node at a given location" << endl;
        cout << "3. Display list" << endl;
        cout << "4. Delete node by position" << endl;
        cout << "5. Count number of nodes" << endl;
        cout << "6. Exit" << endl;
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Enter value to insert at head: ";
                cin >> new_value;
                myList.insertAtHead(new_value);
                myList.displayList();
                break;

            case 2:
                cout << "Enter location: ";
                cin >> location;
                cout << "Enter value to insert: ";
                cin >> new_value;
                myList.insertAtLocation(location, new_value);
                myList.displayList();
                break;

            case 3:
                cout << "Linked list: ";
                myList.displayList();
                break;

            case 4:
                cout << "Enter position to delete: ";
                cin >> position;
                myList.deleteNode(position);
                myList.displayList();
                break;

            case 5:
                cout << "The linked list has " << myList.countList() << " nodes" << endl;
                break;

            case 6:
                cout << "Exiting..." << endl;
                break;

            default:
                cout << "Invalid choice. Try again." << endl;
        }

    } while (choice != 6);

    return 0;
}
