#include <iostream>
using namespace std;

class Node {
public:
    int value;
    Node* next;
};

class List {
private:
    Node* head;

public:
    List() {
        head = NULL;
    }

    void insertAtHead(int new_value) {
        Node* temp = new Node();
        temp->value = new_value;
        temp->next = head;
        head = temp;
    }

    void insertAtLocation(int location, int new_value) {
        Node* temp = head;

        for (int i = 1; i < location - 1; i++) {
            temp = temp->next;
        }

        Node* newNode = new Node();
        newNode->value = new_value;
        newNode->next = temp->next;
        temp->next = newNode;
    }

    void displayList() {
        Node* temp = head;
        while (temp != NULL) {
            cout << temp->value << " ";
            temp = temp->next;
        }
        cout << endl;
    }

    void deleteNode(int position) {
        Node* temp = head;

        if (position == 1) {
            head = temp->next;
            cout << "The node deleted by the user is at position " << position << ". Which had the data " << temp->value << endl;
            delete temp;
            return;
        }

        for (int i = 1; i < position - 1; i++) {
            temp = temp->next;
        }

        Node* tempPtr = temp->next;
        temp->next = temp->next->next;
        cout << "The node deleted by the user is at position " << position << ". Which had the data " << tempPtr->value << endl;
        delete tempPtr;
    }

    int countList() {
        Node* temp = head;
        int count = 0;
        while (temp != NULL) {
            count++;
            temp = temp->next;
        }
        return count;
    }
};

int main() {
    List myList;

    myList.insertAtHead(10);
    myList.insertAtHead(20);
    myList.insertAtHead(30);
    myList.insertAtLocation(3, 40);

    cout << "List: ";
    myList.displayList();
    cout << "Number of nodes: " << myList.countList() << endl;

    myList.deleteNode(3);

    cout << "List after deletion: ";
    myList.displayList();
    cout << "Number of nodes: " << myList.countList() << endl;

    return 0;
}
