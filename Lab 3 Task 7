#include <iostream>
using namespace std;

class Node {
public:
    int value;
    Node* next;
};

class Queue {
private:
    Node* head;

public:
    Queue() {
        head = NULL;
    }

    void enqueue(int value) {
        Node* temp = NULL;
        Node* newNode = new Node();
        newNode->next = NULL;
        newNode->value = value;

        if (head == NULL) {
            head = newNode;
            return;
        } else {
            for (temp = head; temp->next != NULL; temp = temp->next) {}
            temp->next = newNode;
        }
    }

    void dequeue() {
        if (head == NULL) {
            cout << "The queue is already empty." << endl;
            return;
        }
        Node* temp = head;
        head = head->next;
        delete temp;
    }

    int peek() {
        return head->value;
    }

    bool isEmpty() {
        return (head == NULL ? true : false);
    }

    void display() {
        Node* temp = head;
        while (temp != NULL) {
            cout << temp->value << " ";
            temp = temp->next;
        }
        cout << endl;
    }
};

int main() {

    Queue myQueue;
    int value = 0;

    myQueue.enqueue(10);
    myQueue.enqueue(20);
    myQueue.enqueue(30);

    cout << "Sample queue: ";
    myQueue.display();

    value = myQueue.peek();
    cout << "Front of the queue: " << value << endl;

    myQueue.enqueue(100);

    cout << "Queue after enqueue: ";
    myQueue.display();

    myQueue.dequeue();

    cout << "Queue after dequeue: ";
    myQueue.display();

    value = myQueue.peek();
    cout << "Front of the queue: " << value << endl;

    bool empty = myQueue.isEmpty();
    cout << "The queue is " << (empty ? "empty" : "not empty") << endl;

    return 0;
}
