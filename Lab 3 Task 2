#include <iostream>
using namespace std;

class Node {
public:
    int value;
    Node* next;
};

class List {
private:
    Node* head;

public:
    List() {
        head = NULL;
    }

    void insertAtHead(int new_value) {
        Node* temp = new Node();
        temp->value = new_value;
        temp->next = head;
        head = temp;
    }

    void insertAtLocation(int location, int new_value) {
        Node* temp = head;

        for (int i = 1; i < location - 1; i++) {
            temp = temp->next;
        }

        Node* newNode = new Node();
        newNode->value = new_value;
        newNode->next = temp->next;
        temp->next = newNode;
    }

    void displayList() {
        Node* temp = head;
        while (temp != NULL) {
            cout << temp->value << " ";
            temp = temp->next;
        }
        cout << endl;
    }
};

int main() {
    List myList;

    myList.insertAtHead(10);
    myList.insertAtHead(20);
    myList.insertAtHead(30);

    cout << "List before inserting at 3rd location: ";
    myList.displayList();

    myList.insertAtLocation(3, 40);

    cout << "List after inserting at 3rd location: ";
    myList.displayList();

    return 0;
}
